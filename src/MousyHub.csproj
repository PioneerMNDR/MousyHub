<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <RestorePackagesPath>bin\$(Configuration)\.nuget\packages</RestorePackagesPath>
    <ApplicationIcon>mousyIcon.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>

  </PropertyGroup>


  <ItemGroup>
    <Content Remove="wwwroot\LocalModels\**" />
    <None Include="wwwroot\LocalModels\**" />
  </ItemGroup>
  
   <!--Workaround LlamaSharp issue #382.-->
  <ItemGroup>
    <LlamaSharpBackendCpu Include="$(RestorePackagesPath)\llamasharp.backend.cpu\0.24.0\runtimes\**\*.*" />
    <LlamaSharpBackendCuda12 Include="$(RestorePackagesPath)\llamasharp.backend.cuda12.windows\0.24.0\runtimes\**\*.*" />
    <LlamaSharpBackendVulkan Include="$(RestorePackagesPath)\llamasharp.backend.vulkan.windows\0.24.0\runtimes\**\*.*" />
    <KokoroVoices Include="$(RestorePackagesPath)\kokorosharp\0.5.10\content\voices\**\*.*" />
    <KokoroEspeak Include="$(RestorePackagesPath)\kokorosharp\0.5.10\content\espeak\**\*.*" />
    <!--<ONNXRunitime Include="$(RestorePackagesPath)\microsoft.ml.onnxruntime\1.20.1\runtimes\**\*.*" />-->
  </ItemGroup>
  <Target Name="CopyRuntimesFolderOnPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)llama.dll" />
    <Delete Files="$(PublishDir)llava_shared.dll" />
    <Delete Files="$(PublishDir)ggml.dll" />
    <Delete Files="$(PublishDir)ggml-base.dll" />
    <Delete Files="$(PublishDir)ggml-cpu.dll" />
    <Delete Files="$(PublishDir)ggml-vulkan.dll" />
    <Delete Files="$(PublishDir)ggml-cuda.dll" />
    <ItemGroup>
      <FilesToDelete Include="$(PublishDir)**\*.pdb;$(PublishDir)**\*.xml" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
    <Copy SourceFiles="@(LlamaSharpBackendCpu)" DestinationFolder="$(PublishDir)\runtimes\%(RecursiveDir)" />
    <Copy SourceFiles="@(LlamaSharpBackendCuda12)" DestinationFolder="$(PublishDir)\runtimes\%(RecursiveDir)" />
    <Copy SourceFiles="@(LlamaSharpBackendVulkan)" DestinationFolder="$(PublishDir)\runtimes\%(RecursiveDir)" />
    <!--<Copy SourceFiles="@(ONNXRunitime)" DestinationFolder="$(PublishDir)\runtimes\%(RecursiveDir)" />-->
    <Copy SourceFiles="@(KokoroVoices)" DestinationFiles="@(KokoroVoices->'$(PublishDir)\voices\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(KokoroEspeak)" DestinationFiles="@(KokoroEspeak->'$(PublishDir)\espeak\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>


   <!--/Workaround-->
  <ItemGroup>
    <Content Include="mousyIcon.ico" />
  </ItemGroup>
 
 

  <ItemGroup>
    <PackageReference Include="Blazor.SpeechRecognition" Version="9.0.1" />
    <PackageReference Include="CodeBeam.MudBlazor.Extensions" Version="8.2.1" />
    <PackageReference Include="Figgle" Version="0.5.1" />
    <PackageReference Include="GTranslate" Version="2.2.8" />
    <PackageReference Include="KokoroSharp" Version="0.5.10" />
    <PackageReference Include="LLamaSharp" Version="0.24.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.24.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.24.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.24.0" />
    <PackageReference Include="LLamaSharp.kernel-memory" Version="0.24.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.2" />
    <PackageReference Include="Microsoft.KernelMemory.AI.LlamaSharp" Version="0.98.250324.1" />
    <PackageReference Include="Microsoft.KernelMemory.Core" Version="0.98.250324.1" />
    <PackageReference Include="MudBlazor" Version="8.6.0" />
    <PackageReference Include="MudBlazor.Markdown" Version="8.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <PackageReference Include="Spectre.Console" Version="0.49.2-preview.0.4" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Telegram.Bot" Version="22.5.1" />
  </ItemGroup>


  
  <ItemGroup>

    <Folder Include="ThemeManager\" />
    <Folder Include="wwwroot\Cards\" />
    <Folder Include="wwwroot\chatHistory\" />
    <Folder Include="wwwroot\LocalModels\EmbeddingModel\" />
    <Folder Include="wwwroot\MudThemes\" />
    <Folder Include="wwwroot\default\Grammar\" />
  </ItemGroup>
 
  <ItemGroup>
    <ProjectReference Include="..\HuggingfaceHub\HuggingfaceHub\HuggingfaceHub.csproj" />
  </ItemGroup>



</Project>
