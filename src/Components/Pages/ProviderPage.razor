@using MousyHub.Models
@using MousyHub.Models.Misc
@using MousyHub.Models.Services
@using MousyHub.Models.Services.URLHandle
@using MousyHub.Models.User
@inject ProviderService Service
@inject SettingsService Settings
@inject AlertServices Alert

<MudGrid id="select-api">
    <MudItem md="10" xs="7">
        <MudSelect Label="Select API" Variant="Variant.Outlined" Value="Service.SelectType" ValueChanged="@((KeyValuePair<ProviderService.APIType, string> newValue)=>ValueSelectConnectionChange(newValue))" OpenIcon="@Icons.Material.Filled.Api">
            @foreach (var item in Service.ConnectionsTypes)
            {
                <MudSelectItem Value="@item">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.subtitle1" Class="me-2">@item.Value</MudText>
                        @switch (item.Key)
                        {
                            case ProviderService.APIType.Native:
                                <MudChip Size="Size.Small" Style="height:20px" T="string" Color="Color.Success">quick start</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string" Color="Color.Success">local</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string" Color="Color.Primary">based on LlamaSharp</MudChip>
                                break;
                            case ProviderService.APIType.KoboldCPP:
                                <MudChip Size="Size.Small" Style="height:20px" Icon="@Icons.Material.Filled.Star" T="string" Color="Color.Warning">best quality</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string" Color="Color.Success">local</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string">requires another program</MudChip>
                                break;
                            case ProviderService.APIType.Cloud:
                                <MudChip Size="Size.Small" Style="height:20px" Icon="@Icons.Material.Filled.Cloud" T="string" Color="Color.Info">cloud</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string" Color="Color.Success">quick start</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string">usually for a fee</MudChip>
                                <MudChip Size="Size.Small" Style="height:20px" T="string" Color="Color.Dark">BETA</MudChip>
                                break;
                            default:
                                break;
                        }
                    </MudStack>
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem md="2" xs="5" Class="d-flex justify-center align-content-center align-center">
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Success" Indeterminate></MudProgressCircular>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConnectionChanged" FullWidth>Connect</MudButton>
        }
    </MudItem>
</MudGrid>


<MudDivider Class="mt-3 mb-3"></MudDivider>
<MudPaper Elevation="2">
    <MudContainer Class="pa-4">
        <MudGrid Spacing="2" Justify="Justify.SpaceBetween">
            @switch (Service.SelectType.Key)
            {
                case ProviderService.APIType.KoboldCPP:
                    <MudItem md="12">
                        <MudText Typo="Typo.h6">What is KoboldCPP</MudText>
                        <MudPaper Outlined Class="pa-4">
                            <MudStack>

                                <MudText>KoboldCPP is the best backend application for running LLM today. Kobold supports the most modern models, as well as cool and complex samplers that provide the best experience of communicating with characters</MudText>
                                <MudText>
                                    You can download the KoboldCPP program
                                    <MudLink href="https://github.com/LostRuins/koboldcpp/releases" Target="_blank">HERE</MudLink>.
                                    Don't forget to choose the version you need according to your PC's specifications
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem Class="d-flex align-content-center" md="4">
                        <MudTextField @bind-Value="@Settings.User.KoboldURL" Label="URL"></MudTextField>
                    </MudItem>
                 
                    <MudItem Class="d-flex align-content-center align-end" md="4">
                        <MudText>@ModelName</MudText>
                    </MudItem>
           
                    break;
                case ProviderService.APIType.Native:
                    <MudItem Class="d-flex align-content-center">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="12">
                                <MudStack Row AlignItems="AlignItems.End" Class="mb-3">
                                    @if (Settings.LocalModelsList.Count > 0)
                                    {
                                        <MudText>Model:</MudText>
                                        <MudSelect @bind-Value=Settings.User.SelfInferenceConfig.ModelPath ToStringFunc="converter">
                                            @foreach (var item in Settings.LocalModelsList)
                                            {
                                                <MudSelectItem Value="item">@Path.GetFileName(item)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Warning">No models found</MudAlert>
                                        <MudAlert Severity="Severity.Info">
                                            Download GGUF model on
                                            <MudElement HtmlTag="a"
                                                        Class="ms-1"
                                                        Style="color:yellow;font-weight:bold;"
                                                        href="https://huggingface.co/models?pipeline_tag=text-generation&sort=trending"
                                                        target="blank"
                                                        rel="noopener noreferrer">
                                                Hugging Face
                                            </MudElement>
                                            and place them in the LocalModels folder and refresh page
                                        </MudAlert>
                                    }

                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" md="12" Class=" mr-2">
                                <MudGrid Spacing="5">
                                    <MudItem xs="12" md="6">
                                        <MudStack>
                                            <div id="context-length">
                                                <MudTooltip Text="Memory length for the model. 8k recommended for MousyHub.">
                                                    <MudText>Context length: <b>@Settings.User.SelfInferenceConfig.ContextSize</b> </MudText>
                                                </MudTooltip>
                                                <MudSlider Size=Size.Large Variant="Variant.Filled" Color="Color.Tertiary" @bind-Value=Settings.User.SelfInferenceConfig.ContextSize Step="2048" Min="2048" Max="20480" Immediate></MudSlider>
                                            </div>

                                            <div class="mb-3" id="gpu-layer">
                                                <MudTooltip Inline="false" Text="The number of model layers you want to offload to your video card's video memory. For example: model 7-9b consists of 33 layers. These 33 layers fit perfectly into 8GB of VRAM. But the layers of the 12b model are much 'thicker', so 20 layers will fit and the remaining layers will be offloaded to RAM.">
                                                    <MudText>GPU layer count: <b>@Settings.User.SelfInferenceConfig.GpuLayerCount</b> </MudText>
                                                </MudTooltip>
                                                <MudSlider Size=Size.Large Class="small-tick" Variant="Variant.Filled" TickMarks TickMarkLabels="@Util.SliderMarksForGPULayers()" Color="Color.Warning" @bind-Value=Settings.User.SelfInferenceConfig.GpuLayerCount Step="1" Min="0" Max="100" Immediate></MudSlider>
                                            </div>
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudPaper id="other-launch-config" Class="pa-3" Outlined>
                                            <MudGrid Justify="Justify.Center">
                                                <MudItem xs="4" md="4">
                                                    <MudTooltip Text="The number of threads of your processor that will be used to run the model.">
                                                        <MudTextField Variant="Variant.Text" Label="Threads" @bind-Value=Settings.User.SelfInferenceConfig.Threads></MudTextField>
                                                    </MudTooltip>
                                                </MudItem>
                                                <MudItem xs="4" md="4">
                                                    <MudTextField Variant="Variant.Text" Label="Batch Threads" @bind-Value=Settings.User.SelfInferenceConfig.BatchThreads></MudTextField>
                                                </MudItem>
                                                <MudItem xs="4" md="4">
                                                    <MudTextField Variant="Variant.Text" Label="Batch Size" @bind-Value=Settings.User.SelfInferenceConfig.BatchSize></MudTextField>
                                                </MudItem>
                                                <MudItem xs="12" md="3">
                                                    <MudTooltip Text="MLOCK is a way to 'lock' a model in RAM to prevent it from being swapped to disk when the system is low on memory. This helps avoid performance slowdowns. By default, mlock is disabled.">
                                                        <MudSwitch Label="MLOCK" Size=Size.Medium Color="Color.Primary" @bind-Value=Settings.User.SelfInferenceConfig.UseMemoryLock></MudSwitch>
                                                    </MudTooltip>
                                                </MudItem>
                                                <MudItem xs="12" md="3">
                                                    <MudTooltip Text="MMAP is a way of working with files where they are not fully loaded into RAM but instead accessed in smaller parts from the disk as needed. This reduces RAM usage. This feature is enabled by default">
                                                        <MudSwitch Size=Size.Medium Label="MMAP" Color="Color.Secondary" @bind-Value=Settings.User.SelfInferenceConfig.UseMemorymap></MudSwitch>
                                                    </MudTooltip>
                                                </MudItem>
                                                <MudItem xs="12" md="6">
                                                    <MudTooltip Text="Flash Attention is a technology that speeds up the performance of some models on graphics processing units (GPUs) using CUDA/CuBLAS. It makes computations faster and saves memory. However, not all models can use this feature.">
                                                        <MudSwitch Size=Size.Medium Label="Flash attention" Color="Color.Info" @bind-Value=Settings.User.SelfInferenceConfig.UseFlashAttention></MudSwitch>
                                                    </MudTooltip>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>

                                </MudGrid>
                            </MudItem>
                        </MudGrid>


                    </MudItem>
                    break;
                case ProviderService.APIType.Cloud:
                    <MudItem Class="d-flex align-content-center" md="6">
                        <MudForm Class="w-100">
                            <MudTextField @bind-Value="@Settings.User.CloudBasedConfig.BaseUrl" HelperText="example: https://api.llmservice.com/" Variant="Variant.Outlined" InputMode="InputMode.url" Label="URL"></MudTextField>
                            <MudTextField @bind-Value="@Settings.User.CloudBasedConfig.APIKey" Adornment="Adornment.End" InputType="@PasswordInput" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="PasswordVisibleSwitch" AdornmentAriaLabel="Show Password" Variant="Variant.Outlined" Label="API KEY"></MudTextField>
                        </MudForm>
                    </MudItem>
                    <MudItem Class="px-5" md="6">
                        <MudText Typo="Typo.h5">Configuration</MudText>
                        <MudPaper Outlined Class="pa-4">
                            <MudText>Selected model: @(Service.Status ? Service.SelectModel : "Not connected")</MudText>
                            <MudTooltip Text="Parameter that determines whether Cloud services will use Chat completions or Text completions. The latter may be better.">
                                <MudSwitch Size=Size.Medium Label="Use chat completions" Color="Color.Info" @bind-Value=Settings.User.CloudBasedConfig.UseChatCompletions></MudSwitch>
                            </MudTooltip>
                        </MudPaper>

                    </MudItem>
                    <MudItem md="6" Class="d-flex align-center">
                        <MudTooltip Text="Get models">
                            <MudFab OnClick="GetModelList" Disabled="string.IsNullOrEmpty(Settings.User.CloudBasedConfig.BaseUrl)" StartIcon="@Icons.Material.Filled.CloudDownload" Color="Color.Primary">Get models</MudFab>
                        </MudTooltip>
                        <MudDivider Vertical FlexItem Class="mx-3"></MudDivider>
                        <MudAutocomplete MaxItems="int.MaxValue" SearchFunc="@AutocompleteSearch" Clearable Label="Select model" HelperText="Enter URL, click get models and select" Variant="Variant.Outlined" @bind-Value="Service.SelectModel" />
                    </MudItem>

                    break;
                default:
                    break;
            }
        </MudGrid>
    </MudContainer>
</MudPaper>
<MudPaper Class="mt-5 pa-4">
    <MudGrid Spacing="2">
        <MudItem md="@(shouldShowInstructEditor ? 6 : 12)">
            <TextGenParamEditor></TextGenParamEditor>
        </MudItem>
        @if (shouldShowInstructEditor)
        {
            <MudItem md="6">
                <InstructEditor @ref=InstructEditor></InstructEditor>
            </MudItem>
        }
    </MudGrid>
</MudPaper>





@code {
    [CascadingParameter]
    public Main Main { get; set; }
    private string ModelName = "";
    bool isLoading = false;
    Func<string, string> converter = p => Path.GetFileName(p);
    InstructEditor InstructEditor;

    private bool shouldShowInstructEditor =>
    !(Service.SelectType.Key is ProviderService.APIType.Cloud && Settings.User.CloudBasedConfig.UseChatCompletions);

    private async Task ConnectionChanged()
    {
        isLoading = true;
        ModelName = await Service.NewConnect(Settings);
        isLoading = false;
        if (InstructEditor != null && Service.SelectType.Key is not ProviderService.APIType.Cloud)
        {
            InstructEditor.ReRenderState();
        }

    }
    private void ValueSelectConnectionChange(KeyValuePair<ProviderService.APIType, string> newValue)
    {
        Service.SelectType = newValue;
        Service.ChangeConnectionType();
    }

    bool isShowPassword = false;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    void PasswordVisibleSwitch()
    {
        if (isShowPassword)
        {
            isShowPassword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShowPassword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
    private async Task<IEnumerable<string>> AutocompleteSearch(string value, CancellationToken token)
    {
        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value))
            return Service.ModelList;
        return Service.ModelList.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    public async Task GetModelList()
    {
        Settings.User.SaveSettings(Settings);
        if (Settings.User.CloudBasedConfig.BaseUrl == string.Empty)
        {
            Alert.ErrorAlert("Enter URL");
            return;
        }
        Service.ModelList = await URLImporterService.GetModelIdsAsync(Settings.User.CloudBasedConfig.BaseUrl, Settings.User.CloudBasedConfig.APIKey);
        if (Service.ModelList.Count > 0)
        {
            Alert.SuccessAlert("Models loaded!");
        }
        StateHasChanged();
    }



}
