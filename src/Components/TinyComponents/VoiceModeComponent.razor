@using MousyHub.Classes.Services.TTS
@using MousyHub.Models
@using MousyHub.Models.Services
@inject SettingsService Settings
@inject ProviderService Provider
@inject ChatState State
@inject AlertServices Alerts
@inject TranslatorService Translator
@inject STTService STTService
@inject TTSManagerService TTS;
@inject AudioService Audio;
@implements IDisposable

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" style="height:100%">
    <MudGrid Justify="Justify.Center">
        <MudItem md="6" Class="d-flex">
            @{
                var imageSrc = Convert.ToBase64String(ChatClass.ChatHistory.MainCharacter.Avatar);
            }
            <MudImage Elevation="6" Height="400" Width="300" ObjectFit="ObjectFit.Cover" Class="rounded-pill mx-auto" Src="@($"data:image/png;base64,{imageSrc}")"></MudImage>
        </MudItem>
        <MudItem md="12">
            <MudStack Row Justify="Justify.Center">
                <MudTooltip Text="Your queue status">
                    <MudIcon Icon="@(STTService.isRecord ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicOff)" Color="@(STTService.isRecord ? Color.Success : Color.Default)"></MudIcon>
                </MudTooltip>
            </MudStack>
        </MudItem>
        <MudFlexBreak />
        <MudItem md="10" Class="d-flex">
            @if (DialogueIsStarted)
            {
                <canvas id="audioVisualizer" class="border-2 mud-border-white rounded-pill mud-elevation-6  mx-auto"></canvas>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Class=" rounded-pill mud-elevation-6  mx-auto" Size="Size.Large" Color="Color.Primary" OnClick="StartVoiceChat">Let's go!</MudButton>
            }
        </MudItem>
    </MudGrid>
</MudStack>




@code {
    [CascadingParameter]
    public Main Main { get; set; }
    [CascadingParameter]
    public Chat ChatClass { get; set; }
    bool DialogueIsStarted = false;

    private bool IsGenerationEnded = true;
    private bool IsAudioEnded = false;

    protected override void OnInitialized()
    {
        State.StartGenerationEvent += StartGenerationHandler;
        State.EndGenerationEvent += EndGenerationHandler;
        Audio.QueueEmptyEvent += EndAudioQueueHandler;
    }

    private async Task StartGenerationHandler()
    {    
        IsGenerationEnded = false;
        IsAudioEnded = false;
        Console.WriteLine("StartGenerationHandler");
        await InvokeAsync(StateHasChanged);
    }

    private async Task EndGenerationHandler()
    {
        IsGenerationEnded = true;
        Console.WriteLine("EndGenerationHandler");
        await InvokeAsync(StateHasChanged);
        await TryAutoRec();
    }
    private async Task EndAudioQueueHandler()
    {
        @if (TTS.IsQueued==false)
        {
            IsAudioEnded = true;
            Console.WriteLine("EndAudioQueueHandler");
            await InvokeAsync(StateHasChanged);
            await TryAutoRec();
        }

    
    }

    async Task PlayTTSMessage(Message message)
    {

        if (TTS.ReadyToUse)
        {
            if (message.Owner.IsUser)
            {
                await TTS.ProcessFullText(message.Content, Settings.User.TTSOptions.UserKokoroVoice);
            }
            else
            {
                await TTS.ProcessFullText(message.Content, message.Owner.CharacterCard.KokoroVoice);
            }

        }
    }

    async Task TryAutoRec()
    {
        if (IsGenerationEnded && IsAudioEnded)
        {

            await ChatClass.StartRec();
            await InvokeAsync(StateHasChanged);
        }
    
    }
    public async Task StartVoiceChat()
    {
        DialogueIsStarted = true;
        @if (State.ChatHistory.Messages.Count > 0)
        {
            var lastMessage = State.ChatHistory.GetLastMessage();
            await PlayTTSMessage(lastMessage);
            if (lastMessage.Owner.IsUser)
            {
                await ChatClass.SkipUserTurn.InvokeAsync();
            }
            else
            {
                // await TryRec();
            }
        }

    }
    public void Dispose()
    {
        State.StartGenerationEvent -= StartGenerationHandler;
        State.EndGenerationEvent -= EndGenerationHandler;
        Audio.QueueEmptyEvent -= EndAudioQueueHandler;
    }
}
