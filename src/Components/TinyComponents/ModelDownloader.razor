@using MousyHub.Models.Misc
@using MousyHub.Models.Services;
@using MousyHub.Models.Services.URLHandle
@using static MousyHub.Models.Services.DiagnosticsService
@inject HFDownloaderService HFService
@inject UploaderService UploaderService
@inject DiagnosticsService Diagnostic

@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" id="download-page" Class="pt-5 pb-5 childTab ">
    <MudStack Justify="Justify.Center" Row>
        @if (BestGPU != null)
        {
            <MudCard Class="ma-2 pa-1 rounded-xl">
                <MudCardContent>
                    <MudText Typo="Typo.h5">Best GPU</MudText>
                    <MudText>@BestGPU.Model @BestGPU.VRAM_GB Gb</MudText>
                </MudCardContent>
            </MudCard>
        }
        @if (HFService.isBusy)
        {
            <MudCard Class="ma-2 pa-1 rounded-xl">
                <MudCardContent>
                    <MudText>Download progress @HFService.downloadProgress.Progress %</MudText>
                    <MudProgressLinear Color="Color.Primary" Value="@HFService.downloadProgress.Progress"></MudProgressLinear>
                    <MudText>File: @HFService.downloadProgress.FileName</MudText>
                </MudCardContent>
            </MudCard>
        }

    </MudStack>
    <MudDivider Class="my-3"></MudDivider>
    <MudGrid >
        <MudItem md="7">
            <MudGrid Justify="Justify.Center">
                <MudItem md="12" Class="d-flex justify-center"><MudText Typo="Typo.h4"> Main LLM models</MudText></MudItem>
                @foreach (var item in RecommendedModels)
                {
                    <MudItem md="6">
                        <MudCard Class="ma-2 pa-1 rounded-xl" Outlined="true" Style="height: 240px; display: flex; flex-direction: column;">
                            <MudCardContent Style="flex: 1; overflow: hidden;">
                                <MudText Typo="Typo.h5" GutterBottom>@item.Name</MudText>
                                <MudText Style="overflow-y: auto; height: 60px;" Typo="Typo.body2">@item.Description</MudText>

                                <MudStack Row AlignItems="AlignItems.Baseline" Class="mt-3">
                                    <MudText Typo="Typo.h6">Recommended VRAM:</MudText>
                                    <MudText Typo="Typo.h6" Color="@((BestGPU!=null && BestGPU.VRAM_GB<item.RecommendedVRAM) ? Color.Warning : Color.Success)">@item.RecommendedVRAM Gb</MudText>
                                </MudStack>
                            </MudCardContent>
                            <MudCardActions Style="padding-top: 0;">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="rounded-xl" Disabled="@HFService.isBusy" OnClick="@(()=>HFService.DownloadModel(item.RepoName,item.FileNameInRepo))">Download</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
        <MudItem md="5">
            <MudGrid Justify="Justify.Center">
                <MudItem md="12" Class="d-flex justify-center"> <MudText Typo="Typo.h4">Models for RAG</MudText></MudItem>
                <MudItem md="6">
                    <MudCard Class="ma-2 pa-1 rounded-xl" Outlined="true" Style="height: 240px; display: flex; flex-direction: column;">
                        <MudCardContent Style="flex: 1; overflow: hidden;">
                            <MudText Typo="Typo.h5" GutterBottom>nomic-embed-text</MudText>
                            <MudText Style="overflow-y: auto; height: 60px;" Typo="Typo.body2">This model is used exclusively for searching information in saved dialogs. File size: 548 MB</MudText>

                            <MudStack Row AlignItems="AlignItems.Baseline" Class="mt-3">
                                <MudText Typo="Typo.h6">Recommended RAM: </MudText>
                                <MudText Typo="Typo.h6" Color="Color.Success">1 Gb</MudText>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions Style="padding-top: 0;">
                            <MudButton Class="rounded-xl" Variant="Variant.Outlined" Color="Color.Info" Disabled="@HFService.isBusy" OnClick="@(()=>HFService.DownloadEmbeddingModel("nomic-ai/nomic-embed-text-v1.5-GGUF","nomic-embed-text-v1.5.f32.gguf"))">Download</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
  
    </MudItem>

    </MudGrid>




</MudContainer>


@code {
    List<RecommendedModel> RecommendedModels = new List<RecommendedModel>();
    VideoAdapterInfo? BestGPU;
    protected override async Task OnInitializedAsync()
    {
        RecommendedModels = UploaderService.LoadRecommendedModels();
        BestGPU = Diagnostic.GPUs.OrderByDescending(a => a.VRAM_GB).FirstOrDefault();
        HFService.DownloadTickEvent += ReRenderProgressBar;
    }

    private void ReRenderProgressBar(object? o, EventArgs e)
    {
        StateHasChanged();
    }
    public void Dispose()
    {
        HFService.DownloadTickEvent -= ReRenderProgressBar;
    }





}
