@using MousyHub.Models
@using MousyHub.Models.Misc
@using MousyHub.Models.Services
@using MousyHub.Components.Pages
@using MudBlazor.Utilities
@inject ChatState State
@inject SettingsService Settings
@inject ProviderService Provider
@inject TranslatorService Translator
@inject AlertServices Alert
@inject RAGService RAG
@if (State.ChatHistory != null)
{
    <MudStack Row>
        @if (_Main.isMobile == false)
        {
            <MudImage Class="animMouse" Src="Content/mouseWizard.png" Height="200" ObjectFit="ObjectFit.Contain"></MudImage>
        }

        <MudStack Justify="Justify.Center" Wrap="Wrap.Wrap" Class="ma-3 w-100">
            <div>
                <MudText Align="Align.Center">System information</MudText>
                <MudDivider DividerType="DividerType.Middle"></MudDivider>
            </div>

            @if (double.TryParse(Provider.MaxContextSize, out var maxValue) && State.ChatHistory.ChatContextSize.HasValue)
            {
                <div style="width:100%;">
                    <MudText Typo="Typo.caption">Context size:</MudText>
                    <MudProgressLinear Size="Size.Large" Indeterminate="false"
                                       Max="@maxValue"
                                       Value="@(Convert.ToDouble(State.ChatHistory.ChatContextSize.Value))">
                        <MudText Typo="Typo.caption" Color="Color.Surface">
                            <small>   @State.ChatHistory.ChatContextSize.Value / @maxValue </small>

                        </MudText>
                    </MudProgressLinear>
                </div>

            }
            else
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
                    Context: @State.ChatHistory.ChatContextSize /
                    @(Provider.MaxContextSize == "?" ? "Unlimited" : Provider.MaxContextSize)
                </MudAlert>
            }
            <SystemMonitor Mode="SystemMonitor.MonitorMode.RAM" ProgressBar></SystemMonitor>
        </MudStack>
    </MudStack>







    <MudText Typo="Typo.h5" Align="Align.Center">Functions</MudText>
    <MudDivider DividerType="DividerType.Middle"></MudDivider>
    <MudExpansionPanels MultiExpansion Class="ma-3">
        <MudExpansionPanel Text="📖 Narrator">
            <MudTextField @bind-Value="State.ChatHistory.PlayerWishes" Label="Player's wishes" Variant="Variant.Outlined" Adornment="Adornment.End" Clearable AdornmentIcon="@Icons.Material.Filled.GTranslate" OnAdornmentClick="TranslatePlayerWishes" AdornmentAriaLabel="Translate to LLM Language" AutoGrow Lines="2" HelperText="Here you can write what you want the narrator do in his turn" HelperTextOnFocus=true></MudTextField>
            <MudButton Color="Color.Primary" Class="mt-3" Disabled="@(_Main.messengerPage.isBusy || _Main.messengerPage.isGenerating || !Provider.Status)" OnClick="ForceNarrator" Variant="Variant.Filled">Force Narrator</MudButton>
        </MudExpansionPanel>
        <MudExpansionPanel Text="⚖️ Summarize">
            <MudTextField @bind-Value="State.ChatHistory.SummarizeContext" Label="Summarize value" Variant="Variant.Outlined" AutoGrow Lines="4" HelperText="The meaning of dialog summarization" HelperTextOnFocus=true></MudTextField>
            <MudStack Row>
                <MudSwitch @bind-Value=Settings.User.UseStepsSummaryPromt UncheckedColor="Color.Tertiary" Color="Color.Primary">@(Settings.User.UseStepsSummaryPromt ? "Step version" : "Simple version")</MudSwitch>
                <MudSwitch  @bind-Value=Settings.User.AutoSummarize Color="Color.Info" Label="Auto summarize" title="Automatic summarization at achievement of a certain border of a context"></MudSwitch>
            </MudStack>

        </MudExpansionPanel>
        <MudExpansionPanel Text="🎭 OOC">
            <MudTextField @bind-Value="OOCPreview" Label="Give the character a hint outside the context of the dialogue" Variant="Variant.Outlined" AutoGrow Lines="4" HelperText="Example: let the character be less shy" HelperTextOnFocus=true></MudTextField>
            <MudStack Class="mt-3" Row>
                <MudButton Color="Color.Primary" Disabled="@(_Main.messengerPage.isBusy || _Main.messengerPage.isGenerating || !Provider.Status)" OnClick="AddOOCToTextField" Variant="Variant.Filled">add to text field</MudButton>
                <MudButton Color="Color.Secondary" Disabled="@(_Main.messengerPage.isBusy || _Main.messengerPage.isGenerating || !Provider.Status)" OnClick="AddOOCToNextMessage" Variant="Variant.Filled">add to next message</MudButton>
            </MudStack>
        </MudExpansionPanel>
        <MudExpansionPanel Text="🎨 Story Customizer ">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">🎬 Override scenario</MudText>
                <MudTextField @bind-Value="newScenario" Label="Scenario" Variant="Variant.Outlined" Clearable AutoGrow Lines="2" HelperText="Write a new scenario for the dialogue" HelperTextOnFocus=true></MudTextField>
                <MudStack Row>
                    <MudButton Color="Color.Primary" Disabled="@(_Main.messengerPage.isBusy || _Main.messengerPage.isGenerating || !Provider.Status)" OnClick="RewriteScenario" Variant="Variant.Filled">Apply</MudButton>
                    <MudTooltip Text="@State.ChatHistory.InitialScenario">
                        <MudButton StartIcon="@Icons.Material.Filled.Undo" OnClick="RevertScenario" Disabled="string.IsNullOrEmpty(State.ChatHistory.InitialScenario)" Variant="Variant.Outlined">Revert to initial scenario</MudButton>
                    </MudTooltip>
                </MudStack>
            </MudStack>
            <MudDivider Class="my-2"></MudDivider>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">💬 Generate new first message</MudText>
                <MudTextField @bind-Value="NewMessageUserWishes" Label="Player's wishes" Variant="Variant.Outlined" Clearable AutoGrow Lines="2" HelperText="Write what you want to see in the new first message" HelperTextOnFocus=true></MudTextField>
                <MudStack Row  >
                    <MudButton Color="Color.Primary"  Disabled="@(_Main.messengerPage.isBusy || _Main.messengerPage.isGenerating || !Provider.Status)" OnClick="NewFirstMessage" Variant="Variant.Filled">Generate new</MudButton>
                    <MudSwitch Label="Use current first message as a sample" @bind-Value=useCurrentFirstMessageAsSample Color="Color.Primary"></MudSwitch>
                </MudStack>
            </MudStack>

        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudText Typo="Typo.h5" Align="Align.Center">Action Queue</MudText>
    <MudDivider DividerType="DividerType.Middle"></MudDivider>
    <MudDropContainer T="Speaker" Items="State.ChatHistory.SpeakerQueue"
                      @ref="_container" ItemDisabled="@((item)=>item.isWriting==true)" ItemsSelector="@((item,dropzone)=>item.isAction == bool.Parse(dropzone))"
                      ItemDropped="DropZoneItemUpdate" Class="d-flex justify-space-around ma-3 ">
        <ChildContent>
            <MudGrid Spacing="2">
                <MudItem md="6" xs="12">
                    <MudPaper>
                        <MudList T="string" Class="d-flex flex-column mud-height-full" Style="min-height:270px">
                            <MudListSubheader Class="noselect">Not in action</MudListSubheader>
                            <MudDropZone T="Speaker" Identifier="false" CanDropClass="mud-alert-text-error" ApplyDropClassesOnDragStarted="true" Class="flex-grow-1" AllowReorder></MudDropZone>
                        </MudList>
                    </MudPaper>
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudPaper>
                        <MudList T="string" Class="d-flex flex-column mud-height-full" Style="min-height:270px">
                            <MudListSubheader Class="noselect">In action</MudListSubheader>
                            <MudDropZone T="Speaker" CanDropClass="mud-alert-text-success" ApplyDropClassesOnDragStarted="true" Identifier="true" AllowReorder Class="flex-grow-1"></MudDropZone>
                        </MudList>
                    </MudPaper>
                </MudItem>
            </MudGrid>


        </ChildContent>
        <ItemRenderer>
            @if (context.isWriting)
            {
                <MudListItem T="string" Ripple="false" Style="border: 1px solid" Class="generationMessage noselect">
                    <ChildContent>
                        <MudGrid Justify="Justify.Center" Spacing="0">

                            <MudItem md="3">
                                <MudAvatar Class="noselect" draggable="false">
                                    @{
                                        var imageSrc = Convert.ToBase64String(context.Person.Avatar);
                                    }
                                    <MudImage Src="@($"data:image/jpg;base64,{imageSrc}")" Fluid Class="noselect" draggable="false"></MudImage>
                                </MudAvatar>
                            </MudItem>
                            <MudItem md="9">
                                <MudStack Row AlignItems="AlignItems.Center" Style="height:100%">
                                    <MudText>@($"{Util.TruncateString(context.Person.Name, 3)}")</MudText>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </ChildContent>

                </MudListItem>
            }
            else
            {
                string borderClass = "";
                if (context.SkipNow != 0)
                {
                    borderClass = "border-2 border-dashed mud-border-error";
                }
                <MudListItem Ripple="false" T="string" Class="noselect">
                    <ChildContent>
                        <MudGrid Justify="Justify.Center" Spacing="0">
                            <MudItem md="3" xs="3">
                                <MudAvatar Class="@borderClass">
                                    @{
                                        var imageSrc = Convert.ToBase64String(context.Person.Avatar);
                                    }
                                    <MudImage Src="@($"data:image/jpg;base64,{imageSrc}")" Fluid Class="noselect" draggable="false"></MudImage>
                                </MudAvatar>
                            </MudItem>
                            <MudItem md="7" xs="7">
                                <MudStack Row AlignItems="AlignItems.Center" Style="height:100%">
                                    <MudText>@($"{Util.TruncateString(context.Person.Name, 3)}")</MudText>
                                    @if (context.SkipNow > 0)
                                    {
                                        <MudText Color="Color.Info">skip</MudText>
                                    }
                                </MudStack>

                            </MudItem>
                            <MudItem md="2" xs="2">
                                <MudTooltip Text="How many times will not move in queue">
                                    <MudNumericField ShrinkLabel Underline=false Label="Skip" Value="context.SkipCount" ValueChanged="@((int newt)=>{context.SkipCount=newt;context.SkipNow=newt;})" Min="0" HideSpinButtons></MudNumericField>
                                </MudTooltip>
                            </MudItem>
                        </MudGrid>
                    </ChildContent>
                </MudListItem>
            }
        </ItemRenderer>
    </MudDropContainer>
    <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.End">
        <MudText Typo="Typo.h5" Align="Align.Center">Chat memory</MudText>
        <MudTooltip>
            <ChildContent>
                <MudIcon Icon="@Icons.Material.Rounded.Info"></MudIcon>
            </ChildContent>
            <TooltipContent>
                <MudText Typo="Typo.h6">What is this?</MudText>
                <MudText Typo="Typo.body2">RAG is a system for storing your dialogue in internal memory, as well as searching for relevant memory segments to prompt the main model with moments from the past</MudText>
            </TooltipContent>
        </MudTooltip>
        </MudStack>

    <MudDivider DividerType="DividerType.Middle"></MudDivider>
    <MudPaper Outlined Class="ma-3 pa-3">
        <MudStack>
            <MudStack Row AlignItems="AlignItems.Baseline" Justify="Justify.SpaceBetween">
                RAG Status:
                <MudText Color="@(RAG.IsAvailable ? Color.Success : Color.Error)">Available: @RAG.IsAvailable.ToString()</MudText>
                <MudText Color="@(Settings.User.RAGOptions.Enabled ? Color.Success : Color.Error)">Enabled: @Settings.User.RAGOptions.Enabled.ToString()</MudText>
                </MudStack>
            <MudTextField Label="The value retrieved from memory for the bot's next message" MaxLines="4" AutoGrow @bind-Value="State.ChatHistory.MemoryFromChat" ReadOnly></MudTextField>
            <MudButton Variant="Variant.Outlined" OnClick="State.ExportChatToMemory">Remember chat now</MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="ma-3">
        <MudStack Wrap="Wrap.Wrap" Row>
            <MudSwitch Class="ma-2" @bind-Value=Settings.User.PauseBeforeGenerating Color="Color.Info" Label="Pause before generation" title="Bot, will wait for your confirmation after the answer of other bot."></MudSwitch>
            <MudSwitch Class="ma-2" Value="Settings.User.VoiceMode" ValueChanged="@((bool value)=>{Settings.User.VoiceMode=value;  _Main.messengerPage.ReRenderState();})" Color="Color.Info" Label="Voice mode (BETA)"></MudSwitch>
        </MudStack>
    </MudPaper>




}




@code {
    private MudDropContainer<Speaker> _container;
    [CascadingParameter]
    public Main _Main { get; set; }
    string nextWord = "Chat now";
    string OOCPreview = "";
    string maxContextsize = "no data";
    string NewMessageUserWishes = "";
    bool useCurrentFirstMessageAsSample = false;
    string newScenario = "";
    async Task TranslatePlayerWishes()
    {
        State.ChatHistory.PlayerWishes = await Translator.TranslateForLLM(State.ChatHistory.PlayerWishes);
        StateHasChanged();
    }

    public void ReRender()
    {

       InvokeAsync(StateHasChanged);
        if (_container != null)
        {
            _container.Refresh();
        }

    }
    async Task ForceNarrator()
    {
        await _Main.messengerPage.StartGeneration(Provider.Wizard.Narrator, true);

    }
    async Task RewriteScenario()
    {
        State.ChatHistory.InitialScenario = State.ChatHistory.Scenario;
        State.ChatHistory.Scenario = await Translator.TranslateForLLM(newScenario);
        Alert.SuccessAlert("New scenario applied");
        StateHasChanged();
    }
    void RevertScenario()
    {
        State.ChatHistory.Scenario = State.ChatHistory.InitialScenario;
        State.ChatHistory.InitialScenario = "";
        Alert.SuccessAlert("Revert scenario to initial");
        StateHasChanged();
    }

    async Task NewFirstMessage()
    {
        string TranslatedWish = await Translator.TranslateForLLM(NewMessageUserWishes);
        string currentFirstMessage = "";
        if (useCurrentFirstMessageAsSample)
        {
            var message = State.ChatHistory.GetCurrentFirstMessage();
            currentFirstMessage = $"\nSample first message from the card creator. Be sure to use this as a basis for your message!:   [{message.Content}]";
        }

        string PreparePromt = $"\n{State.ChatHistory?.CharDesription}{currentFirstMessage}\nUser's wishes: {TranslatedWish}\n";
        var Response = await Provider.Wizard.WizardRequest(PreparePromt, Wizard.WizardFunction.CustomFirstMessage, 1, 300);
        State.ChatHistory.AddNewAltFirstMessage(Settings.CurrentInstruct, Response.Content);
        await State.ChatHistory.NextFirstMessage(true, Translator);
        _Main.messengerPage.ReRenderState();
    }

    

    async Task AddOOCToNextMessage()
    {
        if (OOCPreview != string.Empty)
        {
            State.ChatHistory.OCC_PlayerWishes = await OOCFormatter();
            OOCPreview = "";
            StateHasChanged();
        }

    }
    async Task AddOOCToTextField()
    {
        if (OOCPreview != string.Empty)
        {
            _Main.messengerPage.FillTextField(await OOCFormatter());
            OOCPreview = "";
            StateHasChanged();
        }

    }
    async Task<string> OOCFormatter()
    {
        OOCPreview = await Translator.TranslateForLLM(OOCPreview);
        return $"`[OOC:{OOCPreview}]`";
    }


    public void DropZoneItemUpdate(MudItemDropInfo<Speaker> dropItem)
    {
        ///Fix bug with multiply dragging
        if (dropItem.Item.isWriting)
        {
            MudItemDropInfo<Speaker> mudItemDrop = new MudItemDropInfo<Speaker>(dropItem.Item, dropItem.DropzoneIdentifier, 0);
            State.ChatHistory.SpeakerQueue.UpdateOrder(mudItemDrop, item => item.Order, 0);
            State.ChatHistory.SpeakerQueue = State.ChatHistory.SpeakerQueue.OrderBy(x => x.Order).ToList();
            StateHasChanged();
            _container.Refresh();
            return;
        }

        dropItem.Item.isAction = bool.Parse(dropItem.DropzoneIdentifier);
        var firstitem = State.ChatHistory.SpeakerQueue.FirstOrDefault(x => x.isWriting);

        var indexOffset = dropItem.DropzoneIdentifier switch
        {
            "false" => State.ChatHistory.SpeakerQueue.Count(x => x.isAction == true),
            _ => 0
        };

        if (dropItem.IndexInZone == 0 && dropItem.Item.isAction == true)
        {
            MudItemDropInfo<Speaker> mudItemDrop = new MudItemDropInfo<Speaker>(dropItem.Item, dropItem.DropzoneIdentifier, 1);
            State.ChatHistory.SpeakerQueue.UpdateOrder(mudItemDrop, item => item.Order, 0);

        }
        else
        {
            State.ChatHistory.SpeakerQueue.UpdateOrder(dropItem, item => item.Order, indexOffset);
        }

        State.ChatHistory.SpeakerQueue = State.ChatHistory.SpeakerQueue.OrderBy(x => x.Order).ToList();
        StateHasChanged();
        _container.Refresh();
    }

}
